# =============================================================================
# RAG 项目 Docker Compose 环境变量
# =============================================================================
# 用法:
#   1. cp docker/.env.example docker/.env
#   2. 把占位符替换成实际值
#   3. .env 已在 .gitignore, 不会被提交
#   4. docker compose up -d 启动, compose 会从同目录 .env 自动读
#
# 注意:
#   - docker compose 同名变量优先级: .env > shell env > compose 内 ${VAR:-default}
#   - POSTGRES_* / NEO4J_* 字段名跟容器内变量名一致, 直接透传
#   - PGADMIN_* 字段名是 compose 缩写, 容器内实际变量叫 PGADMIN_DEFAULT_*
#     (pgadmin 镜像约定), compose 自动做这个 rename
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL + pgvector
# -----------------------------------------------------------------------------
# pgvector 容器启动时用这三个建超级用户 + 默认库
# 生产环境务必改, 别用 postgres/postgres
# 注: 改了 POSTGRES_PASSWORD 之后, packages/service/.env 的 RAG_DB_URL 也必须同步改
# (e.g. POSTGRES_PASSWORD=deyuan888 → RAG_DB_URL=postgresql+psycopg://postgres:deyuan888@localhost:5432/rag)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=rag


# -----------------------------------------------------------------------------
# Neo4j (知识图谱, http://localhost:7474 / bolt://localhost:7687)
# -----------------------------------------------------------------------------
# 格式必须 neo4j/<password>, 容器启动时 neo4j 自动用这个建初始用户
# 留空 = 走 compose 里的默认值 neo4j/315009 (开发用, 生产务必改)
# 注意: 改完后浏览器首次访问 http://localhost:7474 会强制让你改成新密码
NEO4J_AUTH=neo4j/replace-with-strong-password

# -----------------------------------------------------------------------------
# MinIO (对象存储, http://localhost:9000)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin


# -----------------------------------------------------------------------------
# Redis ( http://localhost:6379)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=your_secure_redis_password


# -----------------------------------------------------------------------------
# 前端聊天 CSRF token (构建期变量)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CHAT_TOKEN 在 docker build 阶段被烤进前端 JS 包 (运行时 env 无效),
# compose 通过 build.args 传给 web 镜像. 必须跟 packages/web/.env.local 的
# CHAT_PUBLIC_TOKEN 完全一致, 否则聊天请求的 x-chat-token 校验会被拒 (403).
# 不配则走 compose 默认值 chat-rag-local-dev.
NEXT_PUBLIC_CHAT_TOKEN=chat-rag-local-dev