# 工厂开关: dify (实装) | openai (兼容 OpenAI 格式的任意 API) | llamaindex (留空)
CHAT_PROVIDER=dify

# Dify
DIFY_BASE_URL=http://localhost/v1
# 知识库 dataset API key
DIFY_DATASET_API_KEY=dataset-xxx
# chatflow 应用 API key
DIFY_CHAT_API_KEY=app-xxx

# LLM
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# CSRF 保护: BFF /api/chat/messages 通过 x-chat-token 头验证请求来源
# 部署时请换随机字符串, 且 CHAT_PUBLIC_TOKEN 与 NEXT_PUBLIC_CHAT_TOKEN 必须一致
CHAT_PUBLIC_TOKEN="secret-123"
NEXT_PUBLIC_CHAT_TOKEN="secret-123"

# 后端 (FastAPI) base URL — 前端 server 直连 / BFF 转发都走这个 (仅 server 端用)
# dev 留空用兜底 http://127.0.0.1:8000; 部署改成后端可达的 URL
# RAG_BACKEND_URL=https://your-backend.example.com

# middleware 内外网模式
CHAT_PUBLIC_MODE=false
