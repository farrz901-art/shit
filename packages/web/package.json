{
  "name": "rag-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "powershell -Command \"Get-Process -Name node -ErrorAction SilentlyContinue | Stop-Process -Force\" 2>nul; next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bun": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
    "lint:check": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "prepare": "husky",
    "find-duplicates": "jscpd ../../packages/web/app --format typescript,tsx --no-tips && jscpd ../../packages/service/src --format python --no-tips && bun run scripts/duplication-report.ts",
    "gen-duplication-report": "bun run scripts/duplication-report.ts",
    "check-duplicates:fe": "jscpd ../../packages/web/app --format typescript,tsx --threshold 5 --reporters console --no-tips",
    "check-duplicates:py": "jscpd ../../packages/service/src --format python --threshold 3 --reporters console --no-tips",
    "check-duplicates": "bun run check-duplicates:fe && bun run check-duplicates:py",
    "check:jsdoc": "bun run scripts/check-jsdoc-coverage.ts",
    "check:jsdoc:report": "bun run scripts/check-jsdoc-coverage.ts --report-only"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.19",
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-form": "^1.33.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.18",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.4",
    "diff": "^9.0.0",
    "es-toolkit": "^1.49.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "next-intl": "^4.13.1",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-use": "^17.6.1",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^17.6.3",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.73.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
