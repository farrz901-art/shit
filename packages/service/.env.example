# =============================================================================
# RAG 项目环境变量
# =============================================================================
# 用法: cp .env.example .env.local → 填实际值 → 重启服务
# 优先级: 显式传入 > .env.local > .env > config.toml > 代码默认值
# =============================================================================


# -----------------------------------------------------------------------------
# 鉴权
# -----------------------------------------------------------------------------
# (2026-06-24) bootstrap-only: 首次部署 DB 空时, 调 POST /api/account/seed-admin
# (header x-admin-token == RAG_ADMIN_TOKEN) 创首个 super_admin 账号.
# 创好 super_admin 后即可置空 env (置空后任何 seed-admin 请求 401).
# 跟业务主鉴权 x-user-token 完全独立, 仅作 bootstrap 一次性.
# 调试用 admin token (留空 = 关闭, 生产务必留空!)
RAG_ADMIN_TOKEN=
RAG_SEED_ADMIN_EMAIL=
RAG_SEED_ADMIN_PASSWORD=
RAG_SEED_ADMIN_DISPLAY_NAME=Admin
# (2026-06-24) dev-only: =true 时无 token 自动注入 super_admin(id=1) dev user.
# 等同于登录超级管理员, 0 真实账号. prod 必须 =false (默认).
# 测试基础设施: 15+ tests 依赖 RAG_DEV_AUTH=true 走真 resolve_user 链路.
# 开发模式: 无 token 时不 401, 返回默认 admin 用户
RAG_DEV_AUTH=true


# -----------------------------------------------------------------------------
# LLM
# 同时用做mem0事实抽取 LLM
# -----------------------------------------------------------------------------
LLM_TYPE=openai                # openai / ollama
LLM_MODEL=deepseek-chat
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com   # DeepSeek / OpenAI / Azure
OLLAMA_BASE_URL=http://localhost:11434/v1   # 仅 LLM_TYPE=ollama


# -----------------------------------------------------------------------------
# Embedding
# -----------------------------------------------------------------------------
EMBED_MODEL=BAAI/bge-m3
EMBED_DIMENSIONS=1024           # pgvector 列维度唯一来源 (从 vector_store 读)
EMBED_DEVICE=cpu                # cpu / cuda
EMBED_BATCH_SIZE=32
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-xxx       # DashScope / SiliconFlow / 其它 OpenAI 兼容


# -----------------------------------------------------------------------------
# 数据库 (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
# PG 5 个 env 是 PG 连接的 source of truth, 跟 Docker POSTGRES_* 对齐
# 业务表 (SQLAlchemy) / pgvector / mem0 / Alembic 全用这 5 个
# 不用配 RAG_DB_URL, URL 在代码里用 get_rag_db_url() 现场构造
# 向量列维度自动从 EMBED_DIMENSIONS 读, 不用单独配
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=replace-with-strong-password      # ← 改成 docker 实际密码
PG_DATABASE=rag
# 向量索引调参 (hnsw_m / hnsw_ef_construction / ivfflat_lists) 已搬进 src.retrieval.vector_store
# PGVectorConfig dataclass 默认值, 不再走 env (避免 5 个 env 跟 EMBED_DIMENSIONS 漂移)


# -----------------------------------------------------------------------------
# Neo4j (知识图谱)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-password
NEO4J_DATABASE=neo4j


# -----------------------------------------------------------------------------
# Dify (对话 + 评估)
# -----------------------------------------------------------------------------
DIFY_BASE_URL=http://localhost/v1
DIFY_USER_ID=rag-eval-script
DIFY_DATASET_API_KEY=app-...
# Chatflow 应用 (web BFF, 跟评估不是同一个 key)
DIFY_CHAT_API_KEY=


# -----------------------------------------------------------------------------
# Mem0 (长程记忆, self-host pgvector)
# -----------------------------------------------------------------------------
# 首次 m.add() 时 mem0 自动建表 + 加 vector 扩展
# LLM / Embedding 分别独立配置, 跟上面主模型互不干扰
MEM0_COLLECTION_NAME=mem0_memories
MEM0_SEARCH_LIMIT=5


# -----------------------------------------------------------------------------
# ODA (CAD DWG 转换, 可选)
# -----------------------------------------------------------------------------
ODA_WIN_PATH=E:/ODAFileConverter 27.1.0
ODA_UNIX_PATH=/usr/local/bin/ODAFileConverter


# -----------------------------------------------------------------------------
# Ingest (2026-06-29 ARCH-004 迁移, 原 [paths] / [archive] 段从 config.toml 迁来)
# -----------------------------------------------------------------------------
# 输入目录：存放待处理的 PDF / CAD / 压缩包
INGEST_INPUT_DIR=./ingest_inputs
# 输出目录：转换后 markdown 的落盘位置
INGEST_OUTPUT_DIR=./ingest_outputs
# 压缩包嵌套解压深度 (1 = 不递归, 2/3 = 递归几层)
ARCHIVE_MAX_DEPTH=1
# 解压总大小上限 (字节, 默认 1 GiB, 防 zip bomb)
ARCHIVE_MAX_TOTAL_SIZE=1073741824
# 解压文件总数上限 (防 zip bomb)
ARCHIVE_MAX_FILE_COUNT=10000


# -----------------------------------------------------------------------------
# Langfuse (可观测性, 可选)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com


# -----------------------------------------------------------------------------
# RAGAS (离线评估, 可选)
# -----------------------------------------------------------------------------
# RAGAS 内部用 LLM 做 judge, 共用 OPENAI_API_KEY (见 LLM 段)


# -----------------------------------------------------------------------------
# Object Storage (2026-06-16 RAG 接入 MinIO)
# -----------------------------------------------------------------------------
# Backend 选择: local (默认, dev 用) | minio (生产 / 集成测)
# OBJECT_STORE_BACKEND=local
OBJECT_STORE_BACKEND=minio

# LocalFS impl 根目录 (dev 默认, 已 .gitignore)
OBJECT_STORE_LOCAL_ROOT=./ingest_uploads

# MinIO S3 协议 (boto3 用)
OBJECT_STORE_S3_ENDPOINT=http://localhost:9000
OBJECT_STORE_S3_ACCESS_KEY=minioadmin
OBJECT_STORE_S3_SECRET_KEY=minioadmin      # ← 改成实际值
OBJECT_STORE_S3_BUCKET=rag-ingest
OBJECT_STORE_S3_REGION=us-east-1
OBJECT_STORE_S3_USE_SSL=false             # dev HTTP, 生产 true

# Presigned URL TTL (秒, 5-15 min, 短 TTL 防滥用)
OBJECT_STORE_PRESIGN_TTL_SECONDS=900

# MinIO Stage 临时目录 (open_local 借出路径, 业务用完自动删)
OBJECT_STORE_STAGE_ROOT=/tmp/minio_stage


# -----------------------------------------------------------------------------
# Redis (缓存 / 监控检查, 可选)
# -----------------------------------------------------------------------------
# 默认 localhost:6379, 无密码; 生产环境务必配密码
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis 连接池 / 超时 (2026-06-18 redis spec §4)
REDIS_MAX_CONNECTIONS=20                # 限连接防单核打爆
REDIS_SOCKET_TIMEOUT=2                  # 2s 超时, 失败走原路径 (fail-open)
REDIS_CONNECT_TIMEOUT=2

# 熔断窗口 (2026-06-23): Redis 不可达时, safe_* 静默降级 N 秒, 不再 spam CRITICAL 日志
# 期间业务侧当 cache miss 走原路径; 窗口到期后下次调用探测一次, 成功关熔断
REDIS_CIRCUIT_OPEN_SECONDS=60           # 60s 熔断, 适合 dev / prod 都够稳

# 各 use case TTL (秒)
TOKEN_CACHE_TTL=21600                   # auth token 6h sliding
PERM_CACHE_TTL=60                       # permission matrix 60s
DIFY_QUERY_CACHE_TTL=600                # dify query 10min
EMBED_CACHE_TTL=604800                  # embedding 7d
MEM0_READY_TTL=3600                     # mem0 ready 标记 1h

# 限流 (按 IP)
RL_LOGIN_WINDOW=900                     # 15min
RL_LOGIN_THRESHOLD=5                    # 5 次/15min
RL_RESET_WINDOW=3600                    # 1h
RL_RESET_THRESHOLD=3                    # 3 次/1h

# -----------------------------------------------------------------------------
# 日志系统 (2026-06-17 logging spec §13)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                          # DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_JSON=false                          # dev 彩色 human-readable, prod JSON
LOG_TO_DB=true                          # enqueue 后台写 PG (spec §5)

# 后期接入 hook (本期不实装, env flag 留位置, spec §13 路线图)
GRAFANA_ENABLED=false                   # 后期接 Grafana, 直接连 RAG_DB_URL, 1 天接好
# GRAFANA_URL=http://localhost:3000

SENTRY_ENABLED=false                    # 后期接 Sentry SaaS, 装 sentry-sdk[fastapi] 即可
# SENTRY_DSN=https://xxx@sentry.io/123

LOKI_ENABLED=false                      # 后期接 Loki (K8s / 多服务时), 不接 PG
# LOKI_URL=http://localhost:3100

# -----------------------------------------------------------------------------
# HuggingFace (Camelot ml flavor 权重下载, 2026-07-09)
# -----------------------------------------------------------------------------
# HF_ENDPOINT=https://hf-mirror.com      # 国内镜像, 默认 huggingface.co. 取消注释启用
# HF_HOME=~/.cache/huggingface           # 模型缓存目录, 默认 ~/.cache/huggingface
